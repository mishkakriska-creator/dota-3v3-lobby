#combatFx{position:fixed;inset:0;z-index:92;pointer-events:none;overflow:hidden}
.damage-flash{position:absolute;border-radius:12px;background:linear-gradient(135deg,#ff343473,transparent 65%);box-shadow:inset 0 0 22px #ff3e3e99,inset 0 0 0 2px #ff969699;animation:damage-flash .35s ease-out forwards}
.damage-number{position:absolute;right:10px;top:22%;font-size:22px;color:#ffdfd7;text-shadow:0 2px 4px #220000,0 0 5px #d00000;animation:damage-number .5s ease-out forwards}
@keyframes damage-flash{0%,25%{background-color:#ff3c3c38}100%{background:transparent;box-shadow:inset 0 0 0 transparent}}
@keyframes damage-number{from{opacity:1;translate:0 0}to{opacity:0;translate:0 -24px}}
.requiem-charge,.requiem-burst{position:absolute;width:0;height:0}
.requiem-core{position:absolute;width:130px;height:130px;left:-65px;top:-65px;border-radius:50%;background:radial-gradient(circle,#fd100ea8, #7b00008c 38%,transparent 70%);box-shadow:0 0 20px #ef120666;animation:requiem-charge var(--charge) ease-in forwards}
.requiem-particle{position:absolute;width:8px;height:24px;left:-4px;top:-12px;border-radius:70%;background:linear-gradient(#ffb378,#f21b10,transparent);box-shadow:0 0 9px #fa291c;transform:rotate(var(--angle)) translateY(-110px);animation:requiem-gather .72s var(--delay) ease-in infinite}
@keyframes requiem-charge{0%{scale:.3;opacity:.15}65%{scale:1;opacity:.8}85%{scale:.8;opacity:1}100%{scale:1.2;opacity:1}}
@keyframes requiem-gather{from{transform:rotate(var(--angle)) translateY(-120px);opacity:0}25%{opacity:.9}to{transform:rotate(var(--angle)) translateY(-8px);opacity:0}}
.requiem-wave{position:absolute;width:140px;height:140px;left:-70px;top:-70px;border:4px solid #ed261cc9;border-radius:50%;background:radial-gradient(circle,#ff290877, #28000077 45%,transparent 70%);box-shadow:0 0 25px #ff140d;animation:requiem-wave 1.65s ease-out forwards}
.requiem-soul{position:absolute;left:-8px;top:-36px;width:16px;height:68px;border-radius:70%;background:linear-gradient(#ffc297,#fc3219 15%,#270706c9 48%,transparent);filter:drop-shadow(0 0 5px #c41b14);animation:requiem-soul 1.85s cubic-bezier(.13,.72,.23,1) forwards}
@keyframes requiem-wave{from{scale:.3;opacity:1}to{scale:2.7;opacity:0}}
@keyframes requiem-soul{from{transform:rotate(var(--angle)) translateY(-20px);opacity:1}to{transform:rotate(var(--angle)) translateY(-205px);opacity:0}}
.requiem-bolt{position:absolute;width:100px;height:28px;margin-left:-100px;margin-top:-14px;transform:rotate(var(--direction));transform-origin:right center;border-radius:80%;background:linear-gradient(90deg,transparent,#230303bd,#b5120c,#ff602e);filter:drop-shadow(0 0 9px #f92111)}

/* Invoker spell FX */
.invk-emp,.invk-sunstrike,.invk-meteor,.invk-tornado,.invk-deafblast,.invk-alacrity,.invk-icewall{position:absolute;width:0;height:0;pointer-events:none}
.invk-emp-core{position:absolute;left:-26px;top:-26px;width:52px;height:52px;border-radius:50%;background:radial-gradient(circle,#fff8 0%,#ffb5ff 22%,#de74ff 42%,#8e42dd 68%,transparent 72%);box-shadow:0 0 18px #ff9cff,0 0 44px #8e47ff;animation:invk-emp-core .85s ease-out forwards}
.invk-emp-ring{position:absolute;left:-56px;top:-56px;width:112px;height:112px;border-radius:50%;border:3px solid #ffbeff;box-shadow:0 0 22px #f18cff;animation:invk-emp-ring .95s ease-out forwards}
.invk-emp-bolt{position:absolute;left:-2px;top:-38px;width:4px;height:76px;background:linear-gradient(#fff,#ff93ff,#c94cff,transparent);box-shadow:0 0 12px #f4b8ff;transform:rotate(var(--a));animation:invk-emp-bolt .95s ease-out forwards}
@keyframes invk-emp-core{0%{scale:.15;opacity:0}35%{scale:1;opacity:.95}72%{scale:1.1;opacity:1}100%{scale:1.45;opacity:0}}
@keyframes invk-emp-ring{0%{scale:.25;opacity:0}40%{scale:.9;opacity:.9}100%{scale:1.15;opacity:0}}
@keyframes invk-emp-bolt{0%{opacity:0;scale:.4}38%{opacity:1}100%{opacity:0;scale:1.25}}

.invk-ss-mark{position:absolute;left:-34px;top:-34px;width:68px;height:68px;border-radius:50%;border:3px solid #fff6c1;box-shadow:0 0 18px #fff4a0,inset 0 0 15px #fff4a0;animation:invk-ss-mark 1.15s ease-out forwards}
.invk-ss-beam{position:absolute;left:-12px;top:-320px;width:24px;height:640px;border-radius:999px;background:linear-gradient(180deg,transparent,#fffef5 18%,#fff5ca 35%,#fff 55%,#fff1b2 80%,transparent);box-shadow:0 0 24px #fff5cc,0 0 55px #fff0a5;animation:invk-ss-beam 1.1s ease-out forwards;opacity:0}
.invk-ss-burst{position:absolute;left:-72px;top:-72px;width:144px;height:144px;border-radius:50%;background:radial-gradient(circle,#fff9d7 0%,#ffd269 24%,#ff7a32 48%,#ff3d2e 62%,rgba(255,60,20,.32) 72%,transparent 76%);box-shadow:0 0 32px #ff7a4d;animation:invk-ss-burst 1.1s ease-out forwards;opacity:0}
@keyframes invk-ss-mark{0%{opacity:0;scale:.35}35%{opacity:.9;scale:1}60%{opacity:.7}100%{opacity:0;scale:1.15}}
@keyframes invk-ss-beam{0%,42%{opacity:0}45%{opacity:1}70%{opacity:1}100%{opacity:0}}
@keyframes invk-ss-burst{0%,46%{opacity:0;scale:.4}55%{opacity:1;scale:1}100%{opacity:0;scale:1.18}}

.invk-meteor-rock{position:absolute;left:-44px;top:-44px;width:88px;height:88px;border-radius:50%;background:radial-gradient(circle at 35% 30%,#73432a 0%,#40211c 40%,#241310 74%,#111 100%);box-shadow:0 0 26px #ff7b2f,0 0 55px #ff8a3d;animation:invk-meteor-spin .7s linear forwards}
.invk-meteor-trail{position:absolute;left:-190px;top:-18px;width:230px;height:36px;border-radius:999px;background:linear-gradient(90deg,rgba(255,180,90,0),rgba(255,170,52,.18) 15%,rgba(255,112,33,.65) 48%,rgba(91,23,0,.88) 100%);filter:blur(2px);transform-origin:right center}
.invk-meteor-burst{position:absolute;left:-85px;top:-85px;width:170px;height:170px;border-radius:50%;background:radial-gradient(circle,#fff1c4 0%,#ffdc8c 12%,#ff9e45 28%,#ff522e 44%,rgba(255,60,18,.48) 62%,transparent 74%);box-shadow:0 0 45px #ff7a33;animation:invk-meteor-burst 1.45s ease-out forwards;opacity:0}
@keyframes invk-meteor-spin{from{transform:rotate(0deg)}to{transform:rotate(360deg)}}
@keyframes invk-meteor-burst{0%,48%{opacity:0;scale:.4}54%{opacity:1;scale:1}100%{opacity:0;scale:1.2}}

.invk-tornado-col{position:absolute;left:-45px;top:-112px;width:90px;height:224px;border-radius:45px;background:linear-gradient(180deg,rgba(255,255,255,.05),rgba(235,235,235,.4) 20%,rgba(215,215,215,.22) 44%,rgba(190,190,190,.52) 66%,rgba(255,255,255,.18) 86%,transparent);filter:blur(1px);animation:invk-tornado-col 1.1s ease-in-out forwards}
.invk-tornado-ring{position:absolute;left:-55px;top:-20px;width:110px;height:42px;border-radius:50%;border:3px solid rgba(250,250,250,.6);box-shadow:0 0 16px rgba(255,255,255,.22);animation:invk-tornado-ring 1.1s linear forwards}
.invk-tornado-ring.r1{top:40px;animation-delay:0s}.invk-tornado-ring.r2{top:8px;animation-delay:.08s}.invk-tornado-ring.r3{top:-26px;animation-delay:.16s}
@keyframes invk-tornado-col{0%{opacity:0;scale:.65}15%{opacity:1}100%{opacity:0;scale:1.05}}
@keyframes invk-tornado-ring{0%{transform:translateY(0) scale(.75) rotate(0deg);opacity:0}10%{opacity:.8}100%{transform:translateY(-86px) scale(1.1) rotate(360deg);opacity:0}}

.invk-deafblast{transform:rotate(var(--ang));transform-origin:left center}
.invk-db-wave{position:absolute;left:0;top:-48px;width:100%;height:96px;background:radial-gradient(ellipse at 24% 50%,rgba(255,255,255,.95) 0%,rgba(202,231,255,.82) 18%,rgba(120,178,255,.56) 38%,rgba(111,156,255,.18) 62%,transparent 70%);clip-path:polygon(0 15%,90% 0,100% 50%,90% 100%,0 85%,12% 50%);filter:blur(.4px) drop-shadow(0 0 12px #b6d8ff);animation:invk-deafblast 0.8s ease-out forwards}
@keyframes invk-deafblast{from{opacity:0;transform:translateX(0) scale(.4,.65)}25%{opacity:1}to{opacity:0;transform:translateX(18px) scale(1,.95)}}

.invk-alacrity-body{position:absolute;left:-42px;top:-52px;width:84px;height:104px;border-radius:50%;background:radial-gradient(circle at 50% 50%,rgba(255,222,255,.18),rgba(255,79,228,.16) 38%,rgba(186,92,255,.06) 65%,transparent 72%);box-shadow:0 0 22px rgba(255,112,252,.28);animation:invk-alacrity-body 1.7s ease-out forwards}
.invk-alacrity-orb{position:absolute;width:22px;height:22px;border-radius:50%;background:radial-gradient(circle,#ffe7ff,#ff7cff 52%,#cc4aff 72%,transparent 76%);box-shadow:0 0 16px #f58cff;animation:invk-alacrity-orb 1.7s linear forwards}
.invk-alacrity-orb.o1{left:-6px;top:-46px}.invk-alacrity-orb.o2{left:24px;top:26px;animation-delay:.08s}.invk-alacrity-orb.o3{left:-38px;top:10px;animation-delay:.16s}
@keyframes invk-alacrity-body{0%{opacity:0;scale:.4}18%{opacity:1}100%{opacity:0;scale:1.1}}
@keyframes invk-alacrity-orb{0%{opacity:0;transform:translate(0,0) scale(.55)}15%{opacity:1}100%{opacity:0;transform:translate(10px,-12px) scale(1.15)}}

.invk-icewall-main{position:absolute;left:-260px;top:-36px;width:520px;height:72px;border-radius:24px;background:linear-gradient(90deg,rgba(183,226,255,.12),rgba(210,244,255,.75) 14%,rgba(230,246,255,.92) 50%,rgba(174,219,255,.74) 86%,rgba(183,226,255,.12));clip-path:polygon(0 60%,4% 42%,8% 55%,12% 30%,16% 48%,20% 28%,24% 52%,28% 26%,32% 44%,36% 22%,40% 54%,44% 30%,48% 48%,52% 22%,56% 46%,60% 26%,64% 50%,68% 22%,72% 42%,76% 28%,80% 56%,84% 30%,88% 50%,92% 34%,96% 52%,100% 40%,100% 100%,0 100%);box-shadow:0 0 22px rgba(205,244,255,.7),inset 0 0 24px rgba(255,255,255,.5);animation:invk-icewall 1.25s ease-out forwards}
@keyframes invk-icewall{0%{opacity:0;transform:scale(.88,.7)}18%{opacity:1}100%{opacity:0;transform:scale(1,.98)}}

/* v1.23 Invoker FX overrides */
.invk-emp-core{animation:invk-emp-core 1.48s ease-out forwards!important}
.invk-emp-ring{animation:invk-emp-ring 1.52s ease-out forwards!important}
.invk-emp-bolt{animation:invk-emp-bolt 1.5s ease-out forwards!important}
.invk-emp-charge{position:absolute;left:-74px;top:-74px;width:148px;height:148px;border-radius:50%;border:2px solid rgba(255,196,255,.65);box-shadow:0 0 24px rgba(241,140,255,.42),inset 0 0 24px rgba(241,140,255,.18);animation:invk-emp-charge 1.45s ease-out forwards}
.invk-emp-blast{position:absolute;left:-84px;top:-84px;width:168px;height:168px;border-radius:50%;background:radial-gradient(circle,rgba(255,255,255,.86) 0%,rgba(252,177,255,.66) 22%,rgba(216,102,255,.38) 52%,rgba(130,60,222,.18) 68%,transparent 74%);box-shadow:0 0 42px rgba(255,145,255,.6);animation:invk-emp-blast 1.72s ease-out forwards}
@keyframes invk-emp-charge{0%{opacity:0;scale:.22}18%{opacity:.95}72%{opacity:.82;scale:1.02}100%{opacity:0;scale:1.2}}
@keyframes invk-emp-blast{0%,74%{opacity:0;scale:.42}83%{opacity:1;scale:1}100%{opacity:0;scale:1.24}}
.invk-ss-mark{animation:invk-ss-mark 1.55s ease-out forwards!important}
.invk-ss-beam{animation:invk-ss-beam 1.58s ease-out forwards!important}
.invk-ss-burst{animation:invk-ss-burst 1.58s ease-out forwards!important}
.invk-ss-core{position:absolute;left:-18px;top:-18px;width:36px;height:36px;border-radius:50%;background:radial-gradient(circle,#fffef5 0%,#fff6c8 42%,rgba(255,236,170,.18) 72%,transparent 78%);box-shadow:0 0 16px rgba(255,245,180,.8);animation:invk-ss-core 1.48s ease-out forwards}
@keyframes invk-ss-core{0%{opacity:0;scale:.2}22%{opacity:1;scale:.72}76%{opacity:.84;scale:1}100%{opacity:0;scale:1.14}}
@keyframes invk-ss-mark{0%{opacity:0;scale:.28}22%{opacity:.92;scale:1}74%{opacity:.82}100%{opacity:0;scale:1.18}}
@keyframes invk-ss-beam{0%,72%{opacity:0}78%{opacity:1}92%{opacity:1}100%{opacity:0}}
@keyframes invk-ss-burst{0%,78%{opacity:0;scale:.32}86%{opacity:1;scale:1}100%{opacity:0;scale:1.22}}
.invk-meteor.rolling .invk-meteor-trail{left:-210px;top:-28px;width:250px;height:56px}
.invk-meteor.rolling .invk-meteor-rock{animation:invk-meteor-spin .32s linear infinite!important}
.invk-meteor-scatter{position:absolute;left:-96px;top:-76px;width:192px;height:152px;opacity:0;pointer-events:none}
.invk-meteor-scatter::before,.invk-meteor-scatter::after{content:'';position:absolute;inset:0;background:radial-gradient(circle at 30% 55%,rgba(255,230,180,.95) 0 2px,transparent 3px),radial-gradient(circle at 40% 35%,rgba(255,180,90,.9) 0 3px,transparent 4px),radial-gradient(circle at 58% 48%,rgba(255,100,45,.95) 0 3px,transparent 4px),radial-gradient(circle at 70% 56%,rgba(255,212,160,.85) 0 2px,transparent 3px),radial-gradient(circle at 82% 43%,rgba(255,125,58,.9) 0 2px,transparent 3px);animation:invk-meteor-scatter 2.02s ease-out forwards}
.invk-meteor-scatter::after{filter:blur(1px);opacity:.8}
@keyframes invk-meteor-scatter{0%,86%{opacity:0;transform:scale(.65)}92%{opacity:1;transform:scale(1)}100%{opacity:0;transform:translateX(20px) scale(1.14)}}
.invk-icewall-main{left:-88px!important;top:-20px!important;width:176px!important;height:42px!important;border-radius:16px!important;clip-path:polygon(0 72%,8% 40%,14% 56%,22% 28%,30% 55%,38% 24%,46% 58%,54% 28%,62% 54%,70% 24%,78% 58%,86% 30%,94% 56%,100% 38%,100% 100%,0 100%)!important}
.invk-icewall-freeze{position:absolute;left:-44px;top:-54px;width:88px;height:108px;border-radius:50%;background:radial-gradient(circle,rgba(218,245,255,.18),rgba(160,218,255,.12) 44%,rgba(120,188,255,.08) 66%,transparent 74%);box-shadow:0 0 18px rgba(184,236,255,.45);animation:invk-ice-freeze 1.3s ease-out forwards}
@keyframes invk-ice-freeze{0%{opacity:0;scale:.4}18%{opacity:1}100%{opacity:0;scale:1.08}}


/* v1.42 — Dagon */
.dagon-beam{position:absolute;height:0;transform:rotate(var(--ang));transform-origin:left center;pointer-events:none}
.dagon-ray{position:absolute;left:0;top:-7px;width:100%;height:14px;border-radius:999px;background:linear-gradient(90deg,rgba(255,230,109,0),#ffcf45 10%,#ff6a21 38%,#ff2517 76%,#fff3b5 100%);box-shadow:0 0 8px #ffb326,0 0 16px #ff421c,0 0 30px rgba(255,52,24,.72);clip-path:polygon(0 38%,92% 30%,100% 50%,92% 70%,0 62%);animation:dagon-ray .42s cubic-bezier(.15,.85,.2,1) forwards}
.dagon-core{position:absolute;right:-8px;top:-10px;width:20px;height:20px;border-radius:50%;background:radial-gradient(circle,#fff 0 18%,#ffe97d 28%,#ff6a1d 55%,#f71915 72%,transparent 76%);box-shadow:0 0 16px #ff8b23,0 0 28px #ff2a18;animation:dagon-core .46s ease-out forwards}
.dagon-impact{position:absolute;width:0;height:0;pointer-events:none}
.dagon-impact i{position:absolute;left:-42px;top:-42px;width:84px;height:84px;border-radius:50%;background:radial-gradient(circle,#fff7b7 0 12%,#ffc33c 22%,#ff5b1d 43%,rgba(255,30,16,.52) 60%,transparent 73%);box-shadow:0 0 18px #ff9d2d,0 0 36px rgba(255,43,20,.72);animation:dagon-impact .68s ease-out forwards}
.dagon-impact b{position:absolute;left:-68px;top:-9px;width:136px;height:18px;border-radius:50%;border:3px solid rgba(255,198,62,.78);box-shadow:0 0 14px #ff5c24;animation:dagon-ring .68s ease-out forwards}
@keyframes dagon-ray{0%{opacity:0;transform:scaleX(.08)}15%{opacity:1}72%{opacity:1;transform:scaleX(1)}100%{opacity:0;transform:scaleX(1)}}
@keyframes dagon-core{0%{opacity:0;scale:.25}40%{opacity:1;scale:1.1}100%{opacity:0;scale:1.6}}
@keyframes dagon-impact{0%{opacity:0;scale:.25}24%{opacity:1;scale:1}100%{opacity:0;scale:1.45}}
@keyframes dagon-ring{0%{opacity:0;scale:.25}30%{opacity:1;scale:1}100%{opacity:0;scale:1.8}}


/* v1.86.25 — Abaddon FX */
.abaddon-mist-coil{position:absolute;width:0;height:0;transform:rotate(var(--ang));transform-origin:left center;pointer-events:none}
.abaddon-mist-trail{position:absolute;left:0;top:-11px;width:var(--dist);height:22px;border-radius:999px;background:linear-gradient(90deg,rgba(218,250,255,0),rgba(180,242,255,.18) 14%,rgba(115,204,255,.55) 36%,rgba(94,149,255,.7) 58%,rgba(35,54,112,.9) 88%,rgba(14,22,52,.95) 100%);filter:blur(1.6px);clip-path:polygon(0 40%,88% 0,100% 50%,88% 100%,0 60%);animation:abaddon-mist-trail .42s ease-out forwards}
.abaddon-mist-core{position:absolute;right:-10px;top:-12px;width:24px;height:24px;border-radius:50%;background:radial-gradient(circle,#ffffff 0 18%,#e8f7ff 30%,#a6ebff 48%,#76c5ff 64%,#3943a6 80%,transparent 82%);box-shadow:0 0 12px #c3f5ff,0 0 24px rgba(109,180,255,.72);animation:abaddon-mist-core .45s ease-out forwards}
.abaddon-mist-impact{position:absolute;right:-24px;top:-24px;width:48px;height:48px;border-radius:50%;background:radial-gradient(circle,#fff 0 16%,rgba(207,245,255,.9) 28%,rgba(115,198,255,.55) 52%,rgba(78,116,224,.24) 68%,transparent 76%);box-shadow:0 0 22px rgba(175,240,255,.75);opacity:0}
.abaddon-mist-coil.impact .abaddon-mist-impact{animation:abaddon-mist-impact .52s ease-out forwards}
@keyframes abaddon-mist-trail{0%{opacity:0;transform:scaleX(.12)}14%{opacity:1}100%{opacity:0;transform:scaleX(1)}}
@keyframes abaddon-mist-core{0%{opacity:0;scale:.25}24%{opacity:1;scale:1}100%{opacity:0;scale:1.3}}
@keyframes abaddon-mist-impact{0%{opacity:0;scale:.25}28%{opacity:1;scale:1}100%{opacity:0;scale:1.5}}
.abaddon-aphotic-shield,.abaddon-borrowed-time{position:absolute;width:0;height:0;pointer-events:none}
.abaddon-shield-body{position:absolute;left:-52px;top:-64px;width:104px;height:128px;border-radius:48% 48% 42% 42%/44% 44% 56% 56%;background:radial-gradient(circle at 50% 42%,rgba(220,248,255,.2),rgba(130,204,255,.14) 36%,rgba(58,92,170,.22) 62%,rgba(24,33,72,.08) 78%,transparent 82%);box-shadow:0 0 18px rgba(143,219,255,.35),inset 0 0 20px rgba(255,255,255,.1);animation:abaddon-shield-body 1.45s ease-out forwards}
.abaddon-shield-line{position:absolute;left:-3px;top:-52px;width:6px;height:104px;border-radius:999px;background:linear-gradient(180deg,rgba(255,255,255,.08),rgba(242,252,255,.95) 48%,rgba(175,226,255,.12));box-shadow:0 0 10px rgba(255,255,255,.45);transform-origin:center center;animation:abaddon-shield-line 1.25s ease-out forwards}
.abaddon-shield-line.l1{transform:rotate(0deg)}.abaddon-shield-line.l2{transform:rotate(60deg)}.abaddon-shield-line.l3{transform:rotate(120deg)}
.abaddon-shield-ring{position:absolute;left:-54px;top:-54px;width:108px;height:108px;border-radius:50%;border:2px solid rgba(205,241,255,.65);box-shadow:0 0 18px rgba(123,204,255,.35);animation:abaddon-shield-ring 1.4s ease-out forwards}
@keyframes abaddon-shield-body{0%{opacity:0;scale:.35}18%{opacity:1}100%{opacity:0;scale:1.05}}
@keyframes abaddon-shield-line{0%{opacity:0;scaleY:.2}22%{opacity:1}100%{opacity:0;scaleY:1.08}}
@keyframes abaddon-shield-ring{0%{opacity:0;scale:.45}24%{opacity:1;scale:1}100%{opacity:0;scale:1.18}}
.abaddon-bt-core{position:absolute;left:-48px;top:-58px;width:96px;height:116px;border-radius:50%;background:radial-gradient(circle at 50% 50%,rgba(255,255,255,.14),rgba(160,238,255,.1) 32%,rgba(57,118,220,.18) 58%,rgba(21,31,74,.08) 72%,transparent 78%);box-shadow:0 0 20px rgba(126,218,255,.42);animation:abaddon-bt-core 1.55s ease-out forwards}
.abaddon-bt-ring{position:absolute;left:-60px;top:-60px;width:120px;height:120px;border-radius:50%;border:3px solid rgba(192,240,255,.7);box-shadow:0 0 24px rgba(130,218,255,.4);animation:abaddon-bt-ring 1.5s ease-out forwards}
.abaddon-bt-ring.r2{left:-76px;top:-76px;width:152px;height:152px;animation-delay:.06s}.abaddon-bt-ring.r3{left:-92px;top:-92px;width:184px;height:184px;animation-delay:.12s}
@keyframes abaddon-bt-core{0%{opacity:0;scale:.28}20%{opacity:1;scale:1}100%{opacity:0;scale:1.12}}
@keyframes abaddon-bt-ring{0%{opacity:0;scale:.2}18%{opacity:.9}100%{opacity:0;scale:1}}


/* v1.86.46 — Mars FX */
.mars-spear,.mars-rebuke,.mars-wall-hit,.mars-arena-summon,.mars-arena-collapse,.mars-spear-impact{position:absolute;width:0;height:0;pointer-events:none}
.mars-spear{transform:translate(-50%,-50%) rotate(var(--ang));transform-origin:center center}
.mars-spear-trail{position:absolute;left:-12px;top:-8px;width:170px;height:16px;border-radius:999px;background:linear-gradient(90deg,rgba(255,200,102,0),rgba(255,181,71,.25) 18%,rgba(255,111,33,.75) 54%,rgba(98,14,0,.92) 100%);filter:blur(1.2px);clip-path:polygon(0 40%,92% 10%,100% 50%,92% 90%,0 60%)}
.mars-spear-head{position:absolute;left:138px;top:-11px;width:42px;height:22px;clip-path:polygon(0 50%,26% 0,100% 50%,26% 100%);background:linear-gradient(90deg,#fff4c7,#ffb446 35%,#ff6822 70%,#7d1600 100%);box-shadow:0 0 12px rgba(255,122,38,.8)}
.mars-spear-chain{position:absolute;left:100px;top:-2px;width:48px;height:4px;border-radius:999px;background:linear-gradient(90deg,rgba(255,214,120,.25),rgba(255,166,59,.95),rgba(114,30,0,.85));opacity:.0;transition:opacity .15s ease}
.mars-spear-victim{position:absolute;left:88px;top:-18px;width:28px;height:36px;border-radius:42% 42% 46% 46%/36% 36% 58% 58%;background:radial-gradient(circle at 50% 35%,rgba(255,245,222,.85) 0 10%,rgba(255,140,84,.55) 38%,rgba(126,18,0,.16) 72%,transparent 78%);box-shadow:0 0 14px rgba(255,118,44,.6);opacity:0;transform:scale(.5)}
.mars-spear.impaled .mars-spear-victim{opacity:1;transform:scale(1)}
.mars-spear.impaled .mars-spear-chain{opacity:1}
.mars-spear-impact-core{position:absolute;left:-44px;top:-44px;width:88px;height:88px;border-radius:50%;background:radial-gradient(circle,#fff5d9 0 12%,#ffcf71 22%,#ff8243 42%,rgba(151,24,0,.46) 62%,transparent 74%);box-shadow:0 0 24px rgba(255,132,54,.78);animation:mars-spear-impact-core .72s ease-out forwards}
.mars-spear-impact-ring{position:absolute;left:-68px;top:-16px;width:136px;height:32px;border-radius:50%;border:3px solid rgba(255,182,95,.84);box-shadow:0 0 16px rgba(255,119,46,.64);animation:mars-spear-impact-ring .78s ease-out forwards}
.mars-spear-impact-pin{position:absolute;left:-18px;top:-84px;width:36px;height:168px;background:linear-gradient(180deg,rgba(255,250,231,0),rgba(255,209,116,.92) 22%,rgba(255,125,55,.72) 54%,rgba(114,16,0,.08) 92%,transparent);box-shadow:0 0 18px rgba(255,136,54,.58);animation:mars-spear-pin .85s ease-out forwards}
@keyframes mars-spear-impact-core{0%{opacity:0;scale:.3}24%{opacity:1;scale:1}100%{opacity:0;scale:1.45}}
@keyframes mars-spear-impact-ring{0%{opacity:0;scale:.25}30%{opacity:1;scale:1}100%{opacity:0;scale:1.75}}
@keyframes mars-spear-pin{0%{opacity:0;transform:scaleY(.25)}25%{opacity:1}100%{opacity:0;transform:scaleY(1.08)}}

.mars-rebuke{transform:translate(-50%,-50%) rotate(var(--ang));transform-origin:left center}
.mars-rebuke-sweep{position:absolute;left:0;top:-76px;width:100%;height:152px;border-radius:0 999px 999px 0;background:radial-gradient(ellipse at 16% 50%,rgba(255,250,236,.96) 0%,rgba(255,209,115,.86) 16%,rgba(255,131,60,.56) 34%,rgba(138,31,0,.24) 58%,transparent 72%);clip-path:polygon(0 12%,72% 0,100% 50%,72% 100%,0 88%,14% 50%);filter:drop-shadow(0 0 14px rgba(255,150,68,.65));animation:mars-rebuke-sweep .82s ease-out forwards}
.mars-rebuke-edge{position:absolute;left:34px;top:-108px;width:calc(100% - 34px);height:216px;border-right:4px solid rgba(255,207,126,.76);border-top:4px solid rgba(255,207,126,.76);border-bottom:4px solid rgba(255,207,126,.76);border-radius:0 999px 999px 0;opacity:.82;filter:drop-shadow(0 0 10px rgba(255,162,88,.5));animation:mars-rebuke-edge .82s ease-out forwards}
.mars-rebuke-impact{position:absolute;right:-38px;top:-46px;width:92px;height:92px;border-radius:50%;background:radial-gradient(circle,#fff5de 0 14%,#ffc867 20%,#ff8d43 42%,rgba(143,18,0,.42) 58%,transparent 72%);box-shadow:0 0 24px rgba(255,124,55,.72);animation:mars-rebuke-impact .76s ease-out forwards}
.mars-rebuke.arena-hit .mars-rebuke-impact{box-shadow:0 0 26px rgba(255,124,55,.9),0 0 48px rgba(198,44,12,.46)}
@keyframes mars-rebuke-sweep{0%{opacity:0;transform:scale(.18,.42)}20%{opacity:1}100%{opacity:0;transform:scale(1,.96)}}
@keyframes mars-rebuke-edge{0%{opacity:0;transform:scale(.15,.38)}24%{opacity:.92}100%{opacity:0;transform:scale(1,.98)}}
@keyframes mars-rebuke-impact{0%{opacity:0;scale:.28}28%{opacity:1;scale:1}100%{opacity:0;scale:1.26}}

.mars-wall-hit-core{position:absolute;left:-36px;top:-36px;width:72px;height:72px;border-radius:50%;background:radial-gradient(circle,#fff4d9 0 16%,#ffce78 24%,#ff7f42 44%,rgba(134,15,0,.4) 66%,transparent 74%);box-shadow:0 0 20px rgba(255,127,66,.72);animation:mars-wall-core .7s ease-out forwards}
.mars-wall-hit-ring{position:absolute;left:-58px;top:-18px;width:116px;height:36px;border-radius:50%;border:3px solid rgba(255,194,118,.82);box-shadow:0 0 16px rgba(255,117,48,.62);animation:mars-wall-ring .78s ease-out forwards}
.mars-wall-hit-shards{position:absolute;left:-76px;top:-76px;width:152px;height:152px;background:radial-gradient(circle at 34% 40%,rgba(255,213,141,.96) 0 2px,transparent 3px),radial-gradient(circle at 54% 32%,rgba(255,170,73,.92) 0 3px,transparent 4px),radial-gradient(circle at 69% 48%,rgba(255,123,54,.9) 0 3px,transparent 4px),radial-gradient(circle at 45% 66%,rgba(182,56,15,.85) 0 2px,transparent 3px),radial-gradient(circle at 76% 64%,rgba(255,224,169,.95) 0 2px,transparent 3px);animation:mars-wall-shards .84s ease-out forwards}
@keyframes mars-wall-core{0%{opacity:0;scale:.26}24%{opacity:1;scale:1}100%{opacity:0;scale:1.34}}
@keyframes mars-wall-ring{0%{opacity:0;scale:.25}32%{opacity:1;scale:1}100%{opacity:0;scale:1.7}}
@keyframes mars-wall-shards{0%{opacity:0;transform:scale(.55)}30%{opacity:1}100%{opacity:0;transform:translateX(12px) scale(1.22)}}

.mars-arena-field{position:absolute;left:0;top:0;width:var(--arenaW);height:var(--arenaH);margin-left:calc(var(--arenaW)/-2);margin-top:calc(var(--arenaH)/-2);transform:translate(-50%,-50%);pointer-events:none;filter:drop-shadow(0 0 22px rgba(207,82,35,.2))}
.mars-arena-floor{position:absolute;left:12%;right:12%;bottom:18%;height:32%;border-radius:50%;background:radial-gradient(ellipse at center,rgba(81,27,11,.42) 0%,rgba(60,19,8,.28) 34%,rgba(25,9,5,.12) 58%,transparent 72%);box-shadow:0 0 36px rgba(218,92,42,.2)}
.mars-arena-ring{position:absolute;left:10%;right:10%;border-radius:50%;border:4px solid rgba(255,186,111,.8)}
.mars-arena-ring.outer{top:10%;bottom:16%;box-shadow:0 0 24px rgba(255,131,52,.38),inset 0 0 22px rgba(255,121,47,.18)}
.mars-arena-ring.inner{top:20%;bottom:26%;border-color:rgba(255,219,159,.28);box-shadow:0 0 12px rgba(255,173,86,.18)}
.mars-arena-smoke{position:absolute;left:9%;top:14%;width:82%;height:58%;border-radius:50%;background:radial-gradient(ellipse at center,rgba(244,186,130,.1),rgba(112,44,22,.12) 42%,transparent 74%);filter:blur(12px);animation:mars-arena-smoke 3.6s linear infinite}
@keyframes mars-arena-smoke{0%{transform:translateX(-4px) scale(1)}50%{transform:translateX(6px) scale(1.03)}100%{transform:translateX(-4px) scale(1)}}
.mars-arena-walls{position:absolute;top:14%;bottom:18%;width:26%;display:flex;align-items:flex-end;justify-content:space-between;pointer-events:none}
.mars-arena-walls.left{left:6%}.mars-arena-walls.right{right:6%}
.mars-arena-wall{position:relative;width:14%;height:100%;display:block;transform-origin:bottom center;animation:mars-arena-wall 1.05s ease-out forwards}
.mars-arena-wall b{position:absolute;left:0;right:0;bottom:0;height:100%;background:linear-gradient(180deg,rgba(255,232,202,.9) 0%,rgba(255,174,93,.94) 10%,rgba(211,89,33,.94) 28%,rgba(121,38,13,.96) 64%,rgba(57,19,9,.95) 100%);clip-path:polygon(18% 100%,18% 40%,50% 6%,82% 40%,82% 100%,100% 100%,100% 34%,70% 0,30% 0,0 34%,0 100%);box-shadow:0 0 10px rgba(255,139,60,.3)}
.mars-arena-wall b::after{content:'';position:absolute;left:16%;right:16%;bottom:66%;height:8%;background:rgba(255,226,182,.58);box-shadow:0 0 8px rgba(255,202,132,.3)}
.mars-arena-wall.w1{height:78%}.mars-arena-wall.w2{height:92%}.mars-arena-wall.w3{height:100%}.mars-arena-wall.w4{height:100%}.mars-arena-wall.w5{height:92%}.mars-arena-wall.w6{height:78%}
@keyframes mars-arena-wall{0%{opacity:0;transform:translateY(18px) scaleY(.6)}25%{opacity:1}100%{opacity:1;transform:translateY(0) scaleY(1)}}
.mars-arena-cinders{position:absolute;inset:0;overflow:hidden}
.mars-arena-cinders span{position:absolute;left:calc(8% + (var(--i) * 4.6%));top:calc(22% + ((var(--i) % 5) * 10%));width:5px;height:5px;border-radius:50%;background:radial-gradient(circle,#fff6d8,#ffbf58 56%,rgba(140,21,0,.2) 74%,transparent 76%);box-shadow:0 0 10px rgba(255,153,72,.52);animation:mars-arena-cinder calc(2.2s + ((var(--i) % 3) * .45s)) linear infinite;opacity:.66}
@keyframes mars-arena-cinder{0%{transform:translate(0,0) scale(.65)}50%{transform:translate(8px,-18px) scale(1)}100%{transform:translate(-6px,-34px) scale(.45);opacity:0}}
.mars-arena-field.ending .mars-arena-ring,.mars-arena-field.ending .mars-arena-wall,.mars-arena-field.ending .mars-arena-cinders span,.mars-arena-field.ending .mars-arena-floor,.mars-arena-field.ending .mars-arena-smoke{animation-duration:.8s!important;animation-fill-mode:forwards}
.mars-arena-field.ending .mars-arena-ring.outer,.mars-arena-field.ending .mars-arena-ring.inner{animation:mars-arena-fade .84s ease-out forwards}
.mars-arena-field.ending .mars-arena-floor{animation:mars-arena-floor-fade .84s ease-out forwards}
.mars-arena-field.ending .mars-arena-smoke{animation:mars-arena-fade .84s ease-out forwards}
.mars-arena-field.ending .mars-arena-wall{animation:mars-arena-crumble .88s ease-in forwards}
.mars-arena-field.ending .mars-arena-cinders span{animation:mars-arena-cinder-end .88s ease-out forwards}
@keyframes mars-arena-fade{to{opacity:0;transform:scale(.94)}}
@keyframes mars-arena-floor-fade{to{opacity:0;transform:scale(.78)}}
@keyframes mars-arena-crumble{0%{opacity:1;transform:translateY(0) scale(1)}40%{opacity:1}100%{opacity:0;transform:translateY(28px) scale(.78)}}
@keyframes mars-arena-cinder-end{to{opacity:0;transform:translateY(26px) scale(.3)}}

.mars-arena-summon-ring{position:absolute;left:-122px;top:-86px;width:244px;height:172px;border-radius:50%;border:4px solid rgba(255,192,116,.84);box-shadow:0 0 30px rgba(255,124,48,.42);animation:mars-arena-summon-ring 1.05s ease-out forwards}
.mars-arena-summon-flash{position:absolute;left:-88px;top:-88px;width:176px;height:176px;border-radius:50%;background:radial-gradient(circle,#fff6d8 0%,#ffd27a 20%,rgba(255,136,61,.36) 42%,rgba(134,31,0,.12) 62%,transparent 72%);box-shadow:0 0 32px rgba(255,134,58,.56);animation:mars-arena-summon-flash 1.05s ease-out forwards}
.mars-arena-summon-dust{position:absolute;left:-146px;top:-106px;width:292px;height:212px;border-radius:50%;background:radial-gradient(ellipse at center,rgba(228,158,102,.18),rgba(122,46,21,.14) 38%,transparent 74%);filter:blur(10px);animation:mars-arena-summon-dust 1.1s ease-out forwards}
@keyframes mars-arena-summon-ring{0%{opacity:0;scale:.36}22%{opacity:1;scale:1}100%{opacity:0;scale:1.14}}
@keyframes mars-arena-summon-flash{0%{opacity:0;scale:.22}25%{opacity:1;scale:1}100%{opacity:0;scale:1.26}}
@keyframes mars-arena-summon-dust{0%{opacity:0;scale:.52}32%{opacity:.9}100%{opacity:0;scale:1.08}}

.mars-arena-collapse-core{position:absolute;left:-94px;top:-94px;width:188px;height:188px;border-radius:50%;background:radial-gradient(circle,rgba(255,245,222,.92) 0%,rgba(255,207,118,.72) 18%,rgba(255,120,52,.44) 36%,rgba(129,28,2,.2) 54%,transparent 70%);box-shadow:0 0 38px rgba(255,128,56,.54);animation:mars-arena-collapse-core 1s ease-out forwards}
.mars-arena-collapse-wave{position:absolute;left:-158px;top:-112px;width:316px;height:224px;border-radius:50%;border:4px solid rgba(255,194,118,.76);box-shadow:0 0 26px rgba(255,134,57,.38);animation:mars-arena-collapse-wave 1s ease-out forwards}
.mars-arena-collapse-dust{position:absolute;left:-180px;top:-140px;width:360px;height:280px;border-radius:50%;background:radial-gradient(ellipse at center,rgba(207,123,70,.22),rgba(110,40,20,.16) 36%,transparent 72%);filter:blur(14px);animation:mars-arena-collapse-dust 1.05s ease-out forwards}
@keyframes mars-arena-collapse-core{0%{opacity:0;scale:.32}22%{opacity:1;scale:1}100%{opacity:0;scale:1.3}}
@keyframes mars-arena-collapse-wave{0%{opacity:0;scale:.3}24%{opacity:1;scale:1}100%{opacity:0;scale:1.26}}
@keyframes mars-arena-collapse-dust{0%{opacity:0;scale:.44}25%{opacity:.95}100%{opacity:0;scale:1.18}}


/* v1.86.46 hotfix — Mars arena/rebuke geometry */
.mars-rebuke{transform:translate(-50%,-50%) rotate(var(--ang));transform-origin:left center}
.mars-rebuke-sweep{position:absolute;left:0;top:-74px;width:100%;height:148px;clip-path:polygon(0 38%,14% 24%,100% 0,100% 100%,14% 76%,0 62%);background:linear-gradient(90deg,rgba(255,243,214,.98) 0%,rgba(255,199,95,.82) 18%,rgba(255,129,53,.58) 48%,rgba(136,30,0,.18) 78%,transparent 100%);filter:drop-shadow(0 0 14px rgba(255,145,64,.68));animation:mars-rebuke-sweep .78s ease-out forwards}
.mars-rebuke-edge{position:absolute;left:24px;top:-74px;width:calc(100% - 24px);height:148px;clip-path:polygon(0 40%,12% 28%,100% 4%,100% 96%,12% 72%,0 60%,7% 50%);background:linear-gradient(90deg,rgba(255,226,175,.44),rgba(255,184,97,.24) 45%,rgba(255,184,97,0));border:none;opacity:.88;filter:drop-shadow(0 0 10px rgba(255,162,88,.46));animation:mars-rebuke-edge .78s ease-out forwards}
.mars-rebuke-impact{position:absolute;right:-26px;top:-34px;width:76px;height:76px;border-radius:50%;background:radial-gradient(circle,#fff5de 0 14%,#ffc867 20%,#ff8d43 42%,rgba(143,18,0,.42) 58%,transparent 72%);box-shadow:0 0 24px rgba(255,124,55,.72);animation:mars-rebuke-impact .76s ease-out forwards}

.mars-arena-field{position:absolute;left:0;top:0;width:var(--arenaW);height:var(--arenaH);margin-left:calc(var(--arenaW)/-2);margin-top:calc(var(--arenaH)/-2);transform:translate(-50%,-50%);pointer-events:none;filter:drop-shadow(0 0 18px rgba(207,82,35,.18))}
.mars-arena-floor{position:absolute;left:15%;right:15%;top:29%;bottom:29%;border-radius:50%;background:radial-gradient(ellipse at center,rgba(74,24,10,.34) 0%,rgba(52,17,7,.18) 40%,transparent 75%);box-shadow:0 0 28px rgba(218,92,42,.14)}
.mars-arena-ring{position:absolute;left:7%;right:7%;height:20%;border:none;background:none}
.mars-arena-ring.outer{top:6%}
.mars-arena-ring.inner{top:auto;bottom:6%}
.mars-arena-ring.outer::before,.mars-arena-ring.inner::before{content:'';position:absolute;inset:0;border:5px solid rgba(255,186,111,.84);border-bottom:none;border-radius:999px 999px 0 0;box-shadow:0 0 24px rgba(255,131,52,.32),inset 0 0 22px rgba(255,121,47,.12)}
.mars-arena-ring.inner::before{border-bottom:none;border-radius:0 0 999px 999px;transform:scaleY(-1)}
.mars-arena-smoke{position:absolute;left:13%;top:22%;width:74%;height:56%;border-radius:50%;background:radial-gradient(ellipse at center,rgba(244,186,130,.08),rgba(112,44,22,.1) 42%,transparent 74%);filter:blur(12px);animation:mars-arena-smoke 3.6s linear infinite}
.mars-arena-walls{position:absolute;top:18%;bottom:18%;width:18%;display:flex;align-items:flex-end;justify-content:space-between;pointer-events:none}
.mars-arena-walls.left{left:9%}.mars-arena-walls.right{right:9%}
.mars-arena-wall{position:relative;width:12%;height:100%;display:block;transform-origin:bottom center;animation:mars-arena-wall 1.05s ease-out forwards}
.mars-arena-wall b{position:absolute;left:0;right:0;bottom:0;height:100%;background:linear-gradient(180deg,rgba(255,232,202,.92) 0%,rgba(255,174,93,.96) 10%,rgba(211,89,33,.96) 28%,rgba(121,38,13,.98) 64%,rgba(57,19,9,.98) 100%);clip-path:polygon(16% 100%,16% 46%,50% 0,84% 46%,84% 100%,100% 100%,100% 38%,68% 4%,32% 4%,0 38%,0 100%);box-shadow:0 0 10px rgba(255,139,60,.28)}
.mars-arena-wall.w1{height:64%}.mars-arena-wall.w2{height:82%}.mars-arena-wall.w3{height:100%}.mars-arena-wall.w4{height:100%}.mars-arena-wall.w5{height:82%}.mars-arena-wall.w6{height:64%}
.mars-arena-cinders{position:absolute;left:17%;right:17%;top:16%;bottom:16%;overflow:hidden}

/* v1.86.49 — exact Mars arena centering + Rebuke frustum */
.mars-arena-field{margin-left:0!important;margin-top:0!important;transform:translate(-50%,-50%)!important}
.mars-rebuke-sweep{top:-88px!important;height:176px!important;clip-path:polygon(0 39%,72% 3%,100% 26%,100% 74%,72% 97%,0 61%)!important;background:linear-gradient(90deg,rgba(255,239,201,.94) 0%,rgba(255,194,96,.8) 18%,rgba(255,126,50,.56) 56%,rgba(150,36,5,.2) 82%,transparent 100%)!important}
.mars-rebuke-edge{left:18px!important;top:-90px!important;width:calc(100% - 18px)!important;height:180px!important;clip-path:polygon(0 40%,72% 4%,100% 27%,100% 73%,72% 96%,0 60%,5% 50%)!important;background:linear-gradient(90deg,rgba(255,226,170,.34),rgba(255,159,70,.2) 50%,transparent 100%)!important}
.mars-rebuke-impact{display:none!important}

/* v1.86.51 — Arena behind cards, closer to Dota 2 */
#game .battlefield{position:relative!important;isolation:isolate}
#game .battlefield>.side,#game .battlefield>.mid{position:relative;z-index:3}
#marsArenaPersistent{z-index:1!important}
.mars-arena-field{overflow:visible!important;filter:drop-shadow(0 0 18px rgba(244,69,18,.24))!important}
.mars-arena-floor{left:8%!important;right:8%!important;top:18%!important;bottom:18%!important;background:radial-gradient(ellipse at center,rgba(45,19,15,.58) 0%,rgba(30,14,12,.42) 48%,rgba(10,6,6,.08) 72%,transparent 78%)!important;box-shadow:inset 0 0 44px rgba(225,57,17,.16),0 0 32px rgba(179,43,12,.18)!important}
.mars-arena-ring{left:4%!important;right:4%!important;height:22%!important}
.mars-arena-ring.outer{top:2%!important}.mars-arena-ring.inner{bottom:2%!important}
.mars-arena-ring.outer::before,.mars-arena-ring.inner::before{border-width:4px!important;border-color:rgba(246,91,30,.72)!important;box-shadow:0 0 16px rgba(255,77,19,.46),inset 0 0 18px rgba(255,56,15,.16)!important}
.mars-arena-smoke{left:5%!important;top:9%!important;width:90%!important;height:82%!important;background:radial-gradient(ellipse at center,rgba(80,34,26,.12),rgba(35,17,16,.18) 48%,transparent 76%)!important;filter:blur(16px)!important}
.mars-arena-walls{top:7%!important;bottom:7%!important;width:22%!important;align-items:center!important}
.mars-arena-walls.left{left:1.5%!important}.mars-arena-walls.right{right:1.5%!important}
.mars-arena-wall{width:12.5%!important;display:block!important;filter:drop-shadow(0 7px 4px rgba(0,0,0,.62)) drop-shadow(0 0 7px rgba(255,55,15,.34))}
.mars-arena-wall b{background:linear-gradient(180deg,#17181b 0%,#27272a 28%,#151517 66%,#08090b 100%)!important;clip-path:polygon(10% 100%,10% 36%,34% 23%,30% 8%,48% 0,66% 8%,62% 23%,90% 36%,90% 100%)!important;box-shadow:inset 0 -10px 10px rgba(0,0,0,.65),0 0 0 1px rgba(83,66,59,.42)!important}
.mars-arena-wall b::before{content:'';position:absolute;left:18%;right:18%;bottom:0;height:24%;background:radial-gradient(ellipse at center bottom,rgba(255,178,70,.98) 0%,rgba(247,67,20,.86) 28%,rgba(164,28,10,.4) 55%,transparent 78%);filter:blur(1px);box-shadow:0 0 10px rgba(255,58,15,.84),0 0 22px rgba(255,91,22,.52)}
.mars-arena-wall b::after{content:''!important;position:absolute!important;left:20%!important;right:20%!important;bottom:19%!important;height:5%!important;background:rgba(255,62,18,.76)!important;box-shadow:0 0 8px rgba(255,69,18,.9)!important}
.mars-arena-wall.w1,.mars-arena-wall.w7{height:62%!important}.mars-arena-wall.w2,.mars-arena-wall.w6{height:78%!important}.mars-arena-wall.w3,.mars-arena-wall.w5{height:92%!important}.mars-arena-wall.w4{height:100%!important}
.mars-arena-cinders{left:4%!important;right:4%!important;top:4%!important;bottom:4%!important}
.mars-arena-cinders span{background:radial-gradient(circle,#fff4c7,#ff9a30 46%,#e83b11 68%,transparent 74%)!important;box-shadow:0 0 9px rgba(255,76,20,.7)!important}


/* v1.86.52 — Mars arena layout matches sketch: side pillars outside cards, behind heroes */
#marsArenaPersistent{z-index:1!important;pointer-events:none!important}
#marsArenaPersistent.mars-arena-field{overflow:visible!important;filter:drop-shadow(0 0 10px rgba(255,93,26,.18)) drop-shadow(0 0 24px rgba(255,58,18,.14))!important}
#marsArenaPersistent .mars-arena-floor{left:15%!important;right:15%!important;top:22%!important;bottom:22%!important;border-radius:50%!important;background:radial-gradient(ellipse at center,rgba(56,24,17,.44) 0%,rgba(33,15,13,.24) 52%,rgba(12,8,10,.06) 74%,transparent 80%)!important;box-shadow:inset 0 0 36px rgba(231,72,24,.14),0 0 22px rgba(180,43,14,.12)!important}
#marsArenaPersistent .mars-arena-ring{left:8%!important;right:8%!important;height:17%!important;border:none!important}
#marsArenaPersistent .mars-arena-ring.outer{top:4%!important;bottom:auto!important}
#marsArenaPersistent .mars-arena-ring.inner{bottom:4%!important;top:auto!important}
#marsArenaPersistent .mars-arena-ring.outer::before,#marsArenaPersistent .mars-arena-ring.inner::before{content:'';position:absolute;inset:0;border:4px solid rgba(255,138,62,.82);box-shadow:0 0 18px rgba(255,99,34,.28),inset 0 0 14px rgba(255,84,24,.12)}
#marsArenaPersistent .mars-arena-ring.outer::before{border-bottom:none;border-radius:999px 999px 0 0}
#marsArenaPersistent .mars-arena-ring.inner::before{border-top:none;border-radius:0 0 999px 999px}
#marsArenaPersistent .mars-arena-smoke{left:14%!important;top:18%!important;width:72%!important;height:64%!important;border-radius:50%!important;background:radial-gradient(ellipse at center,rgba(110,51,32,.10),rgba(46,22,18,.12) 46%,transparent 76%)!important;filter:blur(14px)!important}
#marsArenaPersistent .mars-arena-walls{top:6%!important;bottom:6%!important;width:17%!important;display:flex!important;align-items:flex-end!important;justify-content:space-between!important;pointer-events:none!important}
#marsArenaPersistent .mars-arena-walls.left{left:1.8%!important;right:auto!important}
#marsArenaPersistent .mars-arena-walls.right{right:1.8%!important;left:auto!important}
#marsArenaPersistent .mars-arena-wall{position:relative!important;width:13.2%!important;display:block!important;filter:drop-shadow(0 5px 2px rgba(0,0,0,.60));z-index:2!important}
#marsArenaPersistent .mars-arena-wall.w1,#marsArenaPersistent .mars-arena-wall.w7{height:72%!important}
#marsArenaPersistent .mars-arena-wall.w2,#marsArenaPersistent .mars-arena-wall.w6{height:82%!important}
#marsArenaPersistent .mars-arena-wall.w3,#marsArenaPersistent .mars-arena-wall.w5{height:92%!important}
#marsArenaPersistent .mars-arena-wall.w4{height:100%!important}
#marsArenaPersistent .mars-arena-wall b{position:absolute!important;left:0!important;right:0!important;bottom:0!important;top:auto!important;height:100%!important;background:linear-gradient(180deg,#121316 0%,#252528 26%,#131317 64%,#07080b 100%)!important;clip-path:polygon(12% 100%,12% 42%,34% 28%,31% 12%,46% 0,54% 0,69% 12%,66% 28%,88% 42%,88% 100%,100% 100%,100% 38%,76% 15%,24% 15%,0 38%,0 100%)!important;box-shadow:inset 0 -10px 10px rgba(0,0,0,.56),0 0 0 1px rgba(87,74,70,.44)!important}
#marsArenaPersistent .mars-arena-wall b::before{content:''!important;position:absolute!important;left:19%!important;right:19%!important;bottom:0!important;height:20%!important;background:linear-gradient(180deg,rgba(255,194,104,.94) 0%,rgba(255,92,28,.92) 40%,rgba(146,27,9,.34) 78%,transparent 100%)!important;box-shadow:0 0 8px rgba(255,95,31,.90),0 0 16px rgba(255,117,49,.48)!important;filter:blur(.2px)!important}
#marsArenaPersistent .mars-arena-wall b::after{content:''!important;position:absolute!important;left:18%!important;right:18%!important;bottom:17%!important;height:4%!important;background:rgba(255,176,108,.30)!important;box-shadow:none!important}
#marsArenaPersistent .mars-arena-cinders{left:17%!important;right:17%!important;top:16%!important;bottom:14%!important;overflow:hidden!important}
#marsArenaPersistent .mars-arena-cinders span{opacity:.46!important}


/* v1.86.53 — Invoker Chaos Meteor direction fix for right-side team */
.invk-meteor.dir-left .invk-meteor-trail{left:-40px!important;transform:scaleX(-1)!important;transform-origin:center center!important}
.invk-meteor.dir-left.rolling .invk-meteor-trail{left:-40px!important}
.invk-meteor.dir-left .invk-meteor-scatter::before,.invk-meteor.dir-left .invk-meteor-scatter::after{transform:scaleX(-1)!important;transform-origin:center center!important}
@keyframes invk-meteor-scatter-left{0%,86%{opacity:0;transform:scale(.65) scaleX(-1)}92%{opacity:1;transform:scale(1) scaleX(-1)}100%{opacity:0;transform:translateX(-20px) scale(1.14) scaleX(-1)}}
.invk-meteor.dir-left .invk-meteor-scatter::before,.invk-meteor.dir-left .invk-meteor-scatter::after{animation:invk-meteor-scatter-left 2.02s ease-out forwards!important}


/* v1.86.54 — approved Arena of Blood PNG, no procedural fence */
#marsArenaPersistent.mars-arena-png{
  position:absolute!important;
  margin:0!important;
  transform:none!important;
  pointer-events:none!important;
  z-index:3!important;
  overflow:visible!important;
  filter:none!important;
}
#marsArenaPersistent.mars-arena-png .mars-arena-art{
  position:absolute!important;
  inset:0!important;
  width:100%!important;
  height:100%!important;
  object-fit:fill!important;
  pointer-events:none!important;
  user-select:none!important;
  filter:drop-shadow(0 8px 13px rgba(0,0,0,.52)) drop-shadow(0 0 10px rgba(255,76,20,.16))!important;
}
#marsArenaPersistent.mars-arena-png .mars-arena-ash{
  position:absolute!important;
  inset:7% 8% 4% 8%!important;
  background:
    radial-gradient(circle at 8% 90%,rgba(255,111,36,.22) 0 1px,transparent 2px),
    radial-gradient(circle at 18% 82%,rgba(255,175,75,.18) 0 1px,transparent 2px),
    radial-gradient(circle at 81% 86%,rgba(255,111,36,.20) 0 1px,transparent 2px),
    radial-gradient(circle at 92% 91%,rgba(255,175,75,.18) 0 1px,transparent 2px);
  opacity:.75!important;
  animation:marsArenaAshDrift 2.8s linear infinite!important;
}
@keyframes marsArenaAshDrift{0%{transform:translateY(0);opacity:.45}50%{transform:translateY(-4px);opacity:.8}100%{transform:translateY(-8px);opacity:.35}}
#game .battlefield{position:relative!important;isolation:isolate!important}
#game .battlefield .side{position:relative!important}
#game .battlefield .mid{position:relative!important;z-index:5!important}
#game .battlefield .hero{position:relative!important;z-index:6!important}
#marsArenaPersistent.mars-arena-png{z-index:4!important}
#marsArenaPersistent.mars-arena-png.ending .mars-arena-art{animation:marsArenaPngCollapse .88s cubic-bezier(.3,.02,.7,1) forwards!important;transform-origin:50% 100%!important}
#marsArenaPersistent.mars-arena-png.ending .mars-arena-ash{animation:marsArenaAshBurst .88s ease-out forwards!important}
@keyframes marsArenaPngCollapse{0%{opacity:1;transform:translateY(0) scaleY(1);filter:brightness(1)}35%{opacity:1;transform:translateY(3px) scaleY(.96);filter:brightness(1.15)}100%{opacity:0;transform:translateY(30px) scaleY(.72);filter:brightness(.65) blur(1.5px)}}
@keyframes marsArenaAshBurst{0%{opacity:.45;transform:translateY(0) scale(1)}45%{opacity:.9}100%{opacity:0;transform:translateY(-36px) scale(1.15)}}
/* old procedural arena pieces are intentionally disabled */
#marsArenaPersistent .mars-arena-floor,#marsArenaPersistent .mars-arena-ring,#marsArenaPersistent .mars-arena-smoke,#marsArenaPersistent .mars-arena-walls,#marsArenaPersistent .mars-arena-cinders{display:none!important}


/* v1.86.55 — revert Mars arena to old UI style and align closer to user sketches */
#game .battlefield{position:relative!important;isolation:isolate!important}
#game .battlefield>.side,#game .battlefield>.mid{position:relative!important;z-index:3!important}
#game .battlefield .hero{position:relative!important;z-index:4!important}
#marsArenaPersistent{z-index:1!important;pointer-events:none!important}
#marsArenaPersistent.mars-arena-field{margin:0!important;transform:none!important;overflow:visible!important;filter:none!important}
#marsArenaPersistent.mars-arena-sketch{position:absolute!important;left:0!important;top:0!important;width:var(--arenaW)!important;height:var(--arenaH)!important}
#marsArenaPersistent.mars-arena-sketch .mars-arena-floor,
#marsArenaPersistent.mars-arena-sketch .mars-arena-ring,
#marsArenaPersistent.mars-arena-sketch .mars-arena-smoke,
#marsArenaPersistent.mars-arena-sketch .mars-arena-walls,
#marsArenaPersistent.mars-arena-sketch .mars-arena-cinders,
#marsArenaPersistent.mars-arena-sketch .mars-arena-art,
#marsArenaPersistent.mars-arena-sketch .mars-arena-ash{display:none!important}
#marsArenaPersistent.mars-arena-sketch .mars-arena-half{position:absolute!important;top:0!important;bottom:0!important;width:calc(50% - (var(--arenaMidGap,64px) / 2))!important;pointer-events:none!important}
#marsArenaPersistent.mars-arena-sketch .mars-arena-half.left{left:0!important}
#marsArenaPersistent.mars-arena-sketch .mars-arena-half.right{right:0!important}
#marsArenaPersistent.mars-arena-sketch .mars-arena-pillar{position:absolute!important;bottom:22px!important;width:56px!important;height:calc(100% - 48px)!important;background:linear-gradient(180deg,#17181c 0%,#24252a 24%,#111216 65%,#07080b 100%)!important;box-shadow:inset 0 -12px 12px rgba(0,0,0,.54),0 0 0 1px rgba(84,76,70,.42)!important;z-index:1!important}
#marsArenaPersistent.mars-arena-sketch .mars-arena-half.left .mars-arena-pillar.outer{left:0!important;clip-path:polygon(0 100%,0 12%,34% 0,56% 0,56% 8%,68% 8%,70% 0,100% 0,100% 100%)!important}
#marsArenaPersistent.mars-arena-sketch .mars-arena-half.left .mars-arena-pillar.inner{right:0!important;clip-path:polygon(0 100%,0 0,70% 0,72% 8%,84% 8%,84% 0,100% 12%,100% 100%)!important}
#marsArenaPersistent.mars-arena-sketch .mars-arena-half.right .mars-arena-pillar.outer{right:0!important;clip-path:polygon(0 0,30% 0,30% 8%,44% 8%,44% 0,66% 0,100% 12%,100% 100%,0 100%)!important}
#marsArenaPersistent.mars-arena-sketch .mars-arena-half.right .mars-arena-pillar.inner{left:0!important;clip-path:polygon(0 12%,34% 0,56% 0,56% 8%,68% 8%,70% 0,100% 0,100% 100%,0 100%)!important}
#marsArenaPersistent.mars-arena-sketch .mars-arena-pillar::before{content:''!important;position:absolute!important;left:0!important;right:0!important;bottom:0!important;height:18px!important;background:linear-gradient(180deg,rgba(255,198,122,.96),rgba(255,101,29,.96) 45%,rgba(153,32,11,.32) 85%,transparent)!important;filter:drop-shadow(0 0 6px rgba(255,102,35,.7))!important}
#marsArenaPersistent.mars-arena-sketch .mars-arena-half.left .mars-arena-pillar.outer::after,
#marsArenaPersistent.mars-arena-sketch .mars-arena-half.right .mars-arena-pillar.outer::after,
#marsArenaPersistent.mars-arena-sketch .mars-arena-half.left .mars-arena-pillar.inner::after,
#marsArenaPersistent.mars-arena-sketch .mars-arena-half.right .mars-arena-pillar.inner::after{content:''!important;position:absolute!important;top:14px!important;bottom:18px!important;width:3px!important;background:linear-gradient(180deg,rgba(255,173,83,.90),rgba(255,92,28,.82))!important;box-shadow:0 0 6px rgba(255,92,28,.65)!important}
#marsArenaPersistent.mars-arena-sketch .mars-arena-half.left .mars-arena-pillar.outer::after{right:3px!important}
#marsArenaPersistent.mars-arena-sketch .mars-arena-half.left .mars-arena-pillar.inner::after{left:3px!important}
#marsArenaPersistent.mars-arena-sketch .mars-arena-half.right .mars-arena-pillar.outer::after{left:3px!important}
#marsArenaPersistent.mars-arena-sketch .mars-arena-half.right .mars-arena-pillar.inner::after{right:3px!important}
#marsArenaPersistent.mars-arena-sketch .mars-arena-topcap{position:absolute!important;top:0!important;height:54px!important;background:linear-gradient(180deg,#16181c 0%,#23252a 32%,#0f1014 100%)!important;box-shadow:inset 0 -8px 8px rgba(0,0,0,.42),0 0 0 1px rgba(83,77,72,.40)!important;z-index:1!important}
#marsArenaPersistent.mars-arena-sketch .mars-arena-half.left .mars-arena-topcap{left:56px!important;right:56px!important;clip-path:polygon(0 100%,0 58%,10% 58%,14% 0,40% 0,40% 18%,48% 18%,48% 0,52% 0,52% 18%,60% 18%,60% 0,86% 0,90% 58%,100% 58%,100% 100%)!important}
#marsArenaPersistent.mars-arena-sketch .mars-arena-half.right .mars-arena-topcap{left:56px!important;right:56px!important;clip-path:polygon(0 100%,0 58%,10% 58%,14% 0,40% 0,40% 18%,48% 18%,48% 0,52% 0,52% 18%,60% 18%,60% 0,86% 0,90% 58%,100% 58%,100% 100%)!important}
#marsArenaPersistent.mars-arena-sketch .mars-arena-ember{position:absolute!important;bottom:0!important;height:24px!important;width:70px!important;opacity:.88!important;background:repeating-linear-gradient(100deg,rgba(255,108,34,0) 0 8px,rgba(255,108,34,.95) 8px 10px,rgba(255,176,86,.2) 10px 11px,transparent 11px 16px)!important;filter:drop-shadow(0 0 4px rgba(255,86,27,.72))!important;z-index:0!important}
#marsArenaPersistent.mars-arena-sketch .mars-arena-half.left .mars-arena-ember.ember-outer{left:0!important}
#marsArenaPersistent.mars-arena-sketch .mars-arena-half.left .mars-arena-ember.ember-inner{right:0!important}
#marsArenaPersistent.mars-arena-sketch .mars-arena-half.right .mars-arena-ember.ember-inner{left:0!important}
#marsArenaPersistent.mars-arena-sketch .mars-arena-half.right .mars-arena-ember.ember-outer{right:0!important}
#marsArenaPersistent.mars-arena-sketch.ending{animation:marsArenaSketchFade .88s ease-out forwards!important}
#marsArenaPersistent.mars-arena-sketch.ending .mars-arena-pillar{animation:marsArenaSketchCrumble .88s ease-in forwards!important}
#marsArenaPersistent.mars-arena-sketch.ending .mars-arena-topcap{animation:marsArenaSketchCrumble .88s ease-in forwards!important}
#marsArenaPersistent.mars-arena-sketch.ending .mars-arena-ember{animation:marsArenaSketchFade .88s ease-out forwards!important}
@keyframes marsArenaSketchFade{0%{opacity:1}100%{opacity:0;transform:translateY(20px)}}
@keyframes marsArenaSketchCrumble{0%{opacity:1;transform:translateY(0) scaleY(1)}100%{opacity:0;transform:translateY(26px) scaleY(.78)}}
/* tighter spear pin when a target hits arena wall */
.mars-spear.pinned .mars-spear-chain{opacity:1!important;width:28px!important;left:110px!important}
.mars-spear.pinned .mars-spear-victim{left:112px!important;opacity:1!important;transform:scale(1)!important}
